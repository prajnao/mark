{
  "name": "Mark",
  "description": "Mark is a simple, intuitive way to read markdown files in your browser",
  "version": "1.0.0",
  "manifest_version": "3",
  "content_scripts": [
    {
      "js": ["content/index.ts"],
      "matches": ["file:///*.md"],
      "run_at":"document_start"
    }
  ],
  "permissions": ["storage"]
}

